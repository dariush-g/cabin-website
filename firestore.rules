rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity test used by /dbtest.html. Anyone may read and append a
    // short note; entries cannot be edited or deleted from the browser.
    // Remove this block once real collections exist.
    match /dbtest/{entry} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    // Anonymous click batches recorded by web/src/track.ts and drawn by
    // /heatmap.html. Append-only from the browser; a batch holds at most 50
    // clicks. Readable by anyone, since the heatmap page has no sign-in.
    match /clicks/{batch} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['session', 'page', 'vw', 'vh', 'clicks', 'createdAt'])
        && request.resource.data.session is string
        && request.resource.data.session.size() <= 40
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 100
        && request.resource.data.vw is number
        && request.resource.data.vh is number
        && request.resource.data.clicks is list
        && request.resource.data.clicks.size() > 0
        && request.resource.data.clicks.size() <= 50
        && request.resource.data.createdAt == request.time;
    }

    // Locked by default: nothing else is readable or writable from the
    // browser until a rule for a specific collection is added above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
